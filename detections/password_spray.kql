// Possible spraying, not proof of password reuse. Fixed UTC bins have edge blind spots.
SigninLogs
| where TimeGenerated between (ago(15m) .. now())
| where ResultType in ("50126", "50053")
| where isnotempty(IPAddress) and isnotempty(UserPrincipalName)
| summarize Failures=count(), Users=make_set(tolower(UserPrincipalName), 1000),
    FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated)
    by IPAddress, Window=bin(TimeGenerated, 5m)
| extend DistinctUsers=array_length(Users)
| where Failures >= 10 and DistinctUsers >= 5
| project TimeGenerated=LastSeen, Window, IPAddress, Failures, DistinctUsers, Users, FirstSeen, LastSeen
